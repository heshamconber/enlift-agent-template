# Enlift Agent — environment template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. .gitignore is configured to exclude it.

# Anthropic / Claude Code credentials
# (Usually managed by your subscription login — only needed for headless / CI runs)
# Revoke at: https://console.anthropic.com → API Keys → Revoke
# MAX AGE: 90 days. Record rotation date below when setting this key.
# Last rotated: <YYYY-MM-DD>
ANTHROPIC_API_KEY=

# MCP server credentials
# Add the connectors this specific agent needs.
# Example placeholders — replace with the connectors your agent actually uses.
# All tokens: MAX AGE 90 days. Record rotation date as a comment when setting.
# Revoke at: https://<org>.atlassian.net → Profile → Security → API tokens → Revoke
# Last rotated: <YYYY-MM-DD>
# JIRA_API_TOKEN=
# Revoke at: https://developer.atlassian.com/console/myapps/ → <app> → OAuth credentials → Revoke
# Last rotated: <YYYY-MM-DD>
# CONFLUENCE_API_TOKEN=
# Revoke at: https://app.intercom.com → Settings → Developers → Access tokens → Delete
# Last rotated: <YYYY-MM-DD>
# INTERCOM_ACCESS_TOKEN=

# Client / tenant context
# Set at runtime per session — never hard-coded for a single client
# CLIENT_CONTEXT=

# Audit log destination
# In production, point this to a path outside the agent's trust boundary:
#   Azure Blob mount:  /mnt/audit-blob/
#   S3 mount:          /mnt/s3-audit/
#   Network share:     //audit-server/agents/
# Default (dev only): ./audit
AUDIT_LOG_PATH=./audit
